{
  "manifest_version": 3,
  "name": "OLAC+",
  "version": "6.0.0",
  "description": "Pulizia automatica cookie, cache e dati dei siti.",
  "permissions": [
    "cookies", "tabs", "storage", "browsingData",
    "history", "scripting", "sessions", "notifications",
    "contextMenus", "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
