{
  "manifest_version": 3,
  "name": "Site Cleaner Pro",
  "version": "5.2.0",
  "description": "Pulizia avanzata cookie e dati siti.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "browsingData",
    "history",
    "scripting",
    "sessions",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}